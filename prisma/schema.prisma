generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Singleton row (id = 1) controlling whether voting is currently open.
model PollConfig {
  id          Int       @id @default(1)
  votingOpen  Boolean   @default(false)
  startedAt   DateTime?
}

// Pre-uploaded by the admin before voting opens. Source of truth for who
// is allowed to vote. name/regNo are optional metadata for search/display.
model Allowlist {
  email      String   @id
  name       String?
  regNo      String?
  createdAt  DateTime @default(now())
}

// One row per student who has ever successfully signed in (domain-verified).
model LoginLog {
  email     String   @id
  lastLogin DateTime @default(now())
}

// A "batch" is a graduation year (2023-2026). Each batch has exactly two
// categories: Mister and Miss. batchYear + gender let the UI group
// categories into batches without parsing the display name.
model Category {
  id         Int         @id @default(autoincrement())
  name       String      @unique // e.g. "Mister 2026"
  batchYear  Int                 // e.g. 2026
  gender     String              // "mister" | "miss"
  candidates Candidate[]
  votes      Vote[]

  @@unique([batchYear, gender])
}

model Candidate {
  id         Int      @id @default(autoincrement())
  name       String
  imageUrl   String?
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  votes      Vote[]
}

model Vote {
  id           Int      @id @default(autoincrement())
  studentEmail String
  categoryId   Int
  candidateId  Int
  createdAt    DateTime @default(now())

  category  Category  @relation(fields: [categoryId], references: [id])
  candidate Candidate @relation(fields: [candidateId], references: [id])

  // One vote per student per category, enforced by the DB itself.
  @@unique([studentEmail, categoryId])
}
