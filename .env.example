# Database - TWO connection strings from Neon, used for different things.
#
# DATABASE_URL: the POOLED connection (hostname has "-pooler" in it).
# Used by the running app. Pooling matters once many students hit the
# app at once - it reuses a small set of real Postgres connections
# across many simultaneous serverless function calls, instead of each
# one opening its own.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# DIRECT_URL: the DIRECT connection (no "-pooler" in the hostname).
# Used only by `prisma migrate` / `prisma db push`. Migrations need
# session-level locks that PgBouncer's pooled/transaction mode doesn't
# support - using the pooled URL for migrations causes a connection
# error (P1001). Get both strings from Neon's dashboard: Connection
# Details has a "Pooled connection" toggle - copy it both ways.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Google OAuth (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Your college email domain, no @ sign
ALLOWED_DOMAIN="vitbhopal.ac.in"
# Same value, exposed to the browser for display purposes only (not a security check)
NEXT_PUBLIC_ALLOWED_DOMAIN="vitbhopal.ac.in"

# Comma-separated list of admin emails allowed to control phase / view results
ADMIN_EMAILS="you@vitbhopal.ac.in"
